{
  "manifest_version": 3,
  "name": "Grandson",
  "version": "0.1.0",
  "description": "Explains any web page in plain, friendly words and warns you about scams. Like a patient grandkid sitting next to you.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Grandson" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "js/background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["js/content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["<all_urls>"]
}
